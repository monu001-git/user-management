/* login css */
.login-card {
	background: white;
	border-radius: 20px;
	padding: 3rem 2rem;
	width: 100%;
	max-width: 420px;
	box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
}

.login-card .brand {
	text-align: center;
	margin-bottom: 2rem;
}

.login-card .brand-logo {
	width: 50px;
	height: 50px;
	border-radius: 50%;
	margin: 0 auto 1rem;
}

.login-card .brand h1 {
	font-size: 1.75rem;
	color: #1a1a1a;
	margin-bottom: 0.5rem;
}

.login-card .brand p {
	color: #666;
	font-size: 0.95rem;
}

.login-card .form-group {
	margin-bottom: 1.5rem;
	position: relative;
}

.login-card .form-group label {
	display: block;
	margin-bottom: 0.5rem;
	color: #333;
	font-size: 0.9rem;
	font-weight: 500;
}

.form-group input {
	width: 100%;
	padding: 0.8rem 1rem;
	border: 2px solid #e1e1e1;
	border-radius: 12px;
	font-size: 1rem;
	transition: all 0.3s ease;
}

.login-card .form-group input:focus {
	outline: none;
	border-color: #000;
	box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
}

.login-card .remember-forgot {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 1.5rem;
}

.login-card .remember-me {
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.login-card .remember-me input[type="checkbox"] {
	width: 16px;
	height: 16px;
	border-radius: 4px;
}

.login-card .remember-me label {
	color: #666;
	font-size: 0.9rem;
}

.login-card .forgot-password {
	color: #000;
	text-decoration: none;
	font-size: 0.9rem;
	font-weight: 500;
}

.login-card .login-btn {
	width: 100%;
	padding: 1rem;
	background: #268a70;
	color: white;
	border: none;
	border-radius: 12px;
	font-size: 1rem;
	font-weight: 600;
	cursor: pointer;
	transition: all 0.3s ease;
}

.login-card .login-btn:hover {
	background: #d8374b;
	transform: translateY(-2px);
}

.login-card .login-btn:active {
	transform: translateY(0);
}
