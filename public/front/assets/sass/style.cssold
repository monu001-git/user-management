.slide {
    box-shadow: var(--slide-width);
    display: grid;
    margin: 0px auto;
    max-width: var(--slide-width);
}

.slide-items {
    border-radius: 0px;
    grid-area: 1/1;
    overflow: hidden;
    position: relative;
}
.slide-items img {
    border-radius: 0px;
    height: 92vh;
    width: 100%;
    object-fit: cover;
}
.slide-items>* {
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
}



.slide-items .active {
    opacity: 1;
    pointer-events: initial;
    position: relative;
}

.slide-nav {
    display: grid;
    grid-area: 1/1;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    z-index: 1;
}

.slide-thumbs {
    display: flex;
    grid-column: 1 / 3;
}

.slide-thumb-item {
    background-color: #268a70ad;
    display: block;
    flex: 1;
    height:4px;
    margin:10px 5px;
    overflow: hidden;
}

.slide-thumb-item.active::after {
    animation: thumb 5s forwards linear;
    background-color: rgba(255, 255, 255, 0.9);
    content: '';
    display: block;
    height: inherit;
    transform: translateX(-100%);
}

.slide-next,
.slide-prev {
    opacity: 0;
    -webkit-appearance: none;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
}

@keyframes thumb {
    to {
        transform: initial;
    }
}


