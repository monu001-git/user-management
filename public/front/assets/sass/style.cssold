.department-single {
  position: relative;
  text-align: center;
  padding: 35px 30px;
  border-radius: 40px;
  -webkit-transition: all .4s ease-in-out;
  transition: all .4s ease-in-out;
  margin-bottom: 60px;
  background:#268A70;
  color:#fff;
  min-height: 368px;
}
.department-single:hover {color:#226957;}
.department-single p{color:#fff;line-height: 25px; font-size:16px}
.department-single-img {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  margin: 0 auto;
  padding: 20px 0 30px;
  -webkit-transition: all .4s ease-in-out;
  transition: all .4s ease-in-out;
  color:#fff;
}
.department-single span {
    font-family: "Roboto", sans-serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 33px;
    text-align: center;
    color: #fff;
    display: block;
    margin-top: 40px;
    margin-bottom: 15px;
}
.department-single span:hover {
  color: #226957;	
}
.department-single a {
  -webkit-transition: all .4s ease-in-out;
  transition: all .4s ease-in-out;
  position: absolute;
  bottom: 0;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  opacity: 0;
  visibility: hidden;
}
.department-single a:hover {color:#226957}
.department-single a i {
  font-size: 17px;
  color: #fff;
  padding: 15px;
  background: #dc3545;
  border-radius: 50%;
  -webkit-transition: all .4s ease-in-out;
  transition: all .4s ease-in-out;
}

.department-single:hover  {
  background: #fff;
  border: 0px solid transparent;
  color;#226957;
}
.department-single:hover p{color:#226957}
.department-single:hover span{color:#226957}
.department-single svg path {
    fill: #fff; /* Initial color */
    transition: fill 0.3s ease; /* Smooth transition for color change */
}

.department-single:hover svg path {
    fill: #000; /* New color on hover */
}
.department-single:hover a {
  bottom: -28px;
  opacity: 1;
  visibility: visible;
}

