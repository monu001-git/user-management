.three-button{position:fixed; bottom:0px; width:100%;z-index:1000;text-align:center; background: linear-gradient(0deg, rgb(2 0 36 / 46%) 0%, rgb(6 6 19 / 26%) 0%, rgba(0, 212, 255, 0) 100%); padding:20px}
.three-button a{background:#fff;padding:0px 5px;border-radius:150px; margin:0px 5px; color:#01261C;display: inline-flex;}
.three-button a:hover{background:#D8374B;padding:0px 5px;border-radius:150px; margin:0px 5px; color:#fff}
.three-button .icon{float:left; padding:8px 5px;line-height: 38px;}
.three-button .btn-text{float:left; text-align:left;padding:8px 10px 8px 5px;font-size:16px; ;font-weight:bold;line-height: 20px;}
.three-button .btn-text span{display:block; font-size:12px;font-weight:500;}
.three-button .btn-report{float:left; text-align:left;padding:8px 5px 8px 5px;font-size:16px; ;font-weight:bold;line-height: 38px;}
