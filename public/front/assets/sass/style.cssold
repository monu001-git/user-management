  }
}

.wpo-site-header .header-right .search-toggle-btn .fi:before,
.wpo-site-header .header-right .cart-toggle-btn .fi:before {
  color: #fff;
}

@media (max-width: 991px) {
  .wpo-site-header .header-right .search-toggle-btn .fi:before,
  .wpo-site-header .header-right .cart-toggle-btn .fi:before {
