}

.blog-sidebar .recent-post-widget .post h4 a:hover {
  color: #02AA7E;
}

.blog-sidebar .recent-post-widget .post .details .date {
  font-size: 13px;
  color: #2B433C;
}

.blog-sidebar .recent-post-widget .post .details .date i {
